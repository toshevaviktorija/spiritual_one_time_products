# Copy to .env and fill in secrets. Existing local .env files are preserved.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=venastella
POSTGRES_USER=venastella
POSTGRES_PASSWORD=replace-with-a-random-password
DOCKER_WEB_PORT=8001
DOCKER_PUBLIC_BASE_URL=http://127.0.0.1:8001
STRIPE_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
# Direct PyCharm runs use SQLite unless DATABASE_BACKEND=postgres is set.
# For a separately hosted PostgreSQL server, also set POSTGRES_HOST and POSTGRES_PORT.

RESEND_API_KEY=
# Address on a verified Resend domain. Leave empty until configured.
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# demo is local-only; test needs sk_test_ and whsec_ keys; live needs complete business details.
PAYMENT_MODE=test
INVOICE_BUSINESS_NAME=Venastella
INVOICE_BUSINESS_ADDRESS=
INVOICE_BUSINESS_EMAIL=info@venastella.com
INVOICE_VAT_STATUS=unconfigured
INVOICE_VAT_NUMBER=
INVOICE_VAT_RATE=0.20
